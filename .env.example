# ==== Geral ====
DEBUG=false
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
# "web" é necessário para o gateway avisar o sistema dentro do Docker
ALLOWED_HOSTS=gestao.seudominio.com.br,web,localhost
CSRF_TRUSTED_ORIGINS=https://gestao.seudominio.com.br
SITE_URL=https://gestao.seudominio.com.br
TIME_ZONE=America/Sao_Paulo

# Banco: em branco = SQLite em ./dados (recomendado para começar).
# DATABASE_URL=postgres://usuario:senha@db:5432/gestao

# Backups
BACKUP_RETENCAO_DIAS=30

# ==== WhatsApp ====
# qrcode  = conecta escaneando o QR Code (sem custo; não oficial, há risco de bloqueio do número)
# oficial = API oficial da Meta (pago por mensagem)
WHATSAPP_PROVEDOR=qrcode

# Gateway QR Code — gere um token longo e aleatório (ex.: openssl rand -hex 32)
GATEWAY_TOKEN=troque-por-um-token-longo-e-aleatorio
# Fora do Docker: GATEWAY_URL=http://localhost:3000  (no docker-compose já é definido)
# Intervalo aleatório entre mensagens, em segundos (proteção contra bloqueio)
INTERVALO_MIN_SEG=20
INTERVALO_MAX_SEG=45

# ---- Somente para WHATSAPP_PROVEDOR=oficial ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=invente-um-texto-secreto
WHATSAPP_API_VERSION=v21.0
